# ============================================
# Variables de Entorno - Laburen Challenge
# ============================================
# 
# Este archivo documenta todas las variables de entorno necesarias
# para el proyecto. NO contiene valores reales.
# 
# Para desarrollo local:
# 1. Copia este archivo a `.dev.vars` (para Wrangler)
# 2. O copia a `.env` (para aplicaciones Node.js estándar)
# 3. Completa los valores reales
# 4. Nunca commitees `.env` o `.dev.vars` a Git
#

# ============================================
# Cloudflare D1 Database
# ============================================
# El database_id se obtiene al crear la base de datos con:
# wrangler d1 create laburen-challenge-db
#
# Este valor también debe configurarse en wrangler.toml
CLOUDFLARE_D1_DATABASE_ID=

# ============================================
# Cloudflare Workers (Opcional)
# ============================================
# Si necesitas configurar diferentes entornos
ENVIRONMENT=development

# ============================================
# Chatwoot (Opcional - si el MCP necesita comunicarse directamente)
# ============================================
# Normalmente Laburen maneja la integración con Chatwoot,
# pero si tu MCP necesita acceso directo:
# CHATWOOT_URL=https://chatwootchallenge.laburen.com
# CHATWOOT_API_TOKEN=

# ============================================
# MCP Configuration (Opcional)
# ============================================
# Puerto para servidor MCP local durante desarrollo
# MCP_PORT=3000

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 
# Cloudflare Workers usa BINDINGS, no variables de entorno tradicionales:
# - D1 Database: Se configura en wrangler.toml como [[d1_databases]]
# - Secrets: Se configuran con `wrangler secret put NOMBRE_SECRET`
# 
# Para secrets sensibles en producción, usar:
# wrangler secret put API_KEY
# 
# Los bindings son más seguros que environment variables porque
# están disponibles solo en runtime y no se pueden leer con console.log
